# Copy to .env and adjust. All values have safe defaults for local dev.

# --- Database ---
# Local dev (default): SQLite file.
DATABASE_URL=sqlite:///./uso.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://uso:uso@localhost:5432/uso

# --- Security ---
# Generate a strong value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=480

# --- Bootstrap admin (created on first startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!Admin1
ADMIN_EMAIL=admin@uso.example.com

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- CPM import ---
# Leave unset to auto-detect the header row; set to force a specific 1-based row.
# CPM_HEADER_ROW=3
